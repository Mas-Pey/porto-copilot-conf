# ---------------------------------------------------------------------------
# Runtime configuration for the Fastify backend.
# Copy this file to `.env` and adjust the values for your environment.
# Every variable below is optional; the defaults are shown in the comments.
# ---------------------------------------------------------------------------

# development | production | test          (default: development)
NODE_ENV=development

# Bind address of the HTTP server         (default: 0.0.0.0)
HOST=0.0.0.0

# HTTP port                               (default: 4000)
PORT=4000

# fatal | error | warn | info | debug | trace | silent   (default: info)
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins.
# Use `*` to allow every origin (development only).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Service metadata returned by /api/health
SERVICE_NAME=config1-backend
SERVICE_VERSION=1.0.0

# SQLite datasource.
# Relative `file:` paths are resolved against the `backend/` package root,
# NOT the process CWD, so `npm start` and `npx prisma` always open the same file.
# Use an absolute path only if the database lives outside the package.
DATABASE_URL="file:./dev.db"