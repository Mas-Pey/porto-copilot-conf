    "@prisma/client": "7.10.1",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
