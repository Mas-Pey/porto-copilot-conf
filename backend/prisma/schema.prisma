// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Single-row record describing the portfolio owner.
model Profile {
  id        Int      @id @default(autoincrement())
  headline  String
  bio       String
  location  String
  status    String
  education String
  /// JSON-encoded array of `{ value, label }` KPI cards shown under the hero.
  stats     String   @default("[]")
  updatedAt DateTime @updatedAt
}

/// Portfolio showcase entry.
model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  category    String
  imageUrl    String
  techStack   String
  createdAt   DateTime @default(now())
}

/// Skill badge rendered on the portfolio page.
model Skill {
  id       Int    @id @default(autoincrement())
  name     String
  badgeUrl String
  category String
}

/// Contact form submission.
model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
